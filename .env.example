# SQLite（mode=rwc 表示文件不存在时自动创建）
DATABASE_URL=sqlite://bbs.db?mode=rwc
# MySQL（需先手动创建数据库：CREATE DATABASE bbs CHARACTER SET utf8mb4;）
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/bbs

BIND_ADDR=127.0.0.1:3000
# 登录 token 有效期（小时）
TOKEN_TTL_HOURS=168
# 日志级别
RUST_LOG=tremblio_board=info,tower_http=info
